{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "rquickshare",
  "mainBinaryName": "rquickshare",
  "identifier": "dev.mandre.rquickshare",
  "build": {
    "beforeBuildCommand": "pnpm vite:build",
    "beforeDevCommand": "pnpm vite:dev",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "RQuickShare",
        "width": 440,
        "height": 680,
        "minWidth": 380,
        "minHeight": 520,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "appimage"
    ],
    "icon": [
      "icons/icon.png",
      "icons/32x32.png",
      "icons/48x48.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/256x256.png",
      "icons/512x512.png"
    ],
    "category": "Utility",
    "shortDescription": "Quick Share for Linux",
    "longDescription": "Send and receive files with nearby Android devices using Google's Quick Share protocol.",
    "copyright": "GPL-3.0-only",
    "linux": {
      "deb": {
        "desktopTemplate": "linux/rquickshare.desktop"
      },
      "appimage": {
        "files": {
          "/usr/share/icons/hicolor/scalable/apps/rquickshare.svg": "icons/src/rquickshare.svg",
          "/usr/share/icons/hicolor/symbolic/apps/rquickshare-symbolic.svg": "icons/src/rquickshare-symbolic.svg",
          "/usr/share/icons/hicolor/symbolic/apps/rquickshare-attention-symbolic.svg": "icons/src/rquickshare-attention-symbolic.svg"
        }
      }
    }
  }
}
