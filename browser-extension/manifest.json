{
  "manifest_version": 3,
  "name": "QuickShare",
  "description": "Send the current page, a link or selected text to a nearby phone with QuickShare.",
  "version": "1.0",
  "key": "",
  "icons": { "32": "icon-32.png", "128": "icon-128.png" },
  "action": { "default_title": "Send this page with QuickShare" },
  "background": { "service_worker": "background.js" },
  "permissions": ["activeTab", "contextMenus", "nativeMessaging"]
}
